# Copied to /etc/pve-lab-chat.env by install.sh. Edit, then: systemctl restart pve-lab-chat
#
# Recommended layout: run this ON ai01, next to the model server, so the model API can stay
# bound to 127.0.0.1 and is never exposed to the LAN. Publish only this UI with `tailscale serve`.

# Model server. llama.cpp llama-server / vLLM / LM Studio = openai; Ollama = ollama
BACKEND_URL=http://127.0.0.1:8081
BACKEND_TYPE=openai
# Only if the backend was started with --api-key
API_KEY=

# Pre-selected model id (as listed by /v1/models). Empty = first available.
DEFAULT_MODEL=
SYSTEM_PROMPT=You are a helpful assistant running on the pve-lab home server. Answer in the user's language.
CHAT_TITLE=pve-lab · ai01

# 127.0.0.1 = only reachable through `tailscale serve` (recommended).
# 0.0.0.0 would also expose it to the whole LAN.
HOST=127.0.0.1
PORT=8080

# Second factor on top of Tailscale identity. Strongly recommended; generate with:
#   openssl rand -hex 16
ACCESS_TOKEN=

# Simultaneous generations allowed; extra requests get HTTP 429 instead of piling up on the GPU.
MAX_CONCURRENT=2
BACKEND_TIMEOUT=600
