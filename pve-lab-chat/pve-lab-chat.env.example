# Copied to /etc/pve-lab-chat.env by install.sh. Edit, then: systemctl restart pve-lab-chat

# Where the model runs. Ollama default port is 11434.
# Use ai01's LAN IP if the hostname "ai01" doesn't resolve on this machine.
BACKEND_URL=http://ai01:11434
# ollama  -> Ollama native API (/api/tags, /api/chat)
# openai  -> OpenAI-compatible API (vLLM, llama.cpp server, LM Studio, LocalAI ...)
BACKEND_TYPE=ollama
# Only needed if the OpenAI-compatible backend requires a key
API_KEY=

# Pre-selected model in the dropdown (e.g. qwen2.5:14b). Empty = first available.
DEFAULT_MODEL=
SYSTEM_PROMPT=You are a helpful assistant running on the pve-lab home server. Answer in the user's language.
CHAT_TITLE=pve-lab · ai01

# Listen address. 0.0.0.0 = all interfaces (LAN + Tailscale).
# Set to 127.0.0.1 if you publish it with `tailscale serve` (HTTPS) only.
HOST=0.0.0.0
PORT=8080

# Optional extra password on top of Tailscale. Empty = no password.
ACCESS_TOKEN=

BACKEND_TIMEOUT=600
